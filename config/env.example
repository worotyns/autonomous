# /etc/autonomous/env — secrets, chmod 600, read by herdr.service and gh-bridge.service.
# Copied from this file on first install, never overwritten.

# OpenRouter key for pi. Make a separate key for the agents and give it a credit limit.
OPENROUTER_API_KEY=

# GitHub token of the account whose comments steer the agents (PR comments wake the agent only from this user).
# Fine-grained: the repos below, Contents RW, Issues RW, Pull requests RW, Metadata R, Actions R, Commit statuses R.
GH_TOKEN=

# Optional: the consult agent (overrides [consult] agent in autonomous.toml), e.g. a stronger model.
# AUTONOMOUS_CONSULT_AGENT=pi/openrouter/deepseek/deepseek-v4-pro
