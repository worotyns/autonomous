[Unit]
Description=gh-bridge: GitHub issues -> herdr-projects
After=herdr.service network-online.target
Requires=herdr.service

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/opt/autonomous
Environment=XDG_RUNTIME_DIR=/run/user/@UID@
Environment=HOME=/home/agent
Environment=PATH=/home/agent/.herdr-projects/data/bin:/home/agent/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/autonomous/env
ExecStart=/usr/local/bin/uv run --script /opt/autonomous/bridge.py run
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
